Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (uncomment after you install an SSL certificate — cPanel > SSL/TLS Status > Run AutoSSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block hidden files and the private app folder if it was uploaded here.
    RewriteRule (^|/)\. - [F]
    RewriteRule ^app(/|$) - [F]

    # Everything that is not a real file goes to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<FilesMatch "\.(sql|log|json|lock|md|sample\.php)$">
    Require all denied
</FilesMatch>
