# --- Database (PostgreSQL 14+) ---
# Owner role: runs migrations, background scheduler and authentication tables.
DATABASE_OWNER_URL=postgres://leadorbit_owner:owner_dev@localhost:5432/leadorbit
# Application role: every workspace query runs through this role with row-level security enforced.
DATABASE_APP_URL=postgres://leadorbit_app:app_dev@localhost:5432/leadorbit

# --- Security ---
# 32+ random bytes, base64. Used to encrypt provider API keys at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
APP_URL=http://localhost:3000
# Shared secret for POST /api/cron/tick if you trigger the scheduler from an external cron instead of the worker.
CRON_SECRET=

# --- Public data source etiquette ---
# OpenStreetMap Nominatim/Overpass and other public services require an identifying User-Agent with a contact.
PROVIDER_CONTACT_EMAIL=
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# --- Email notifications (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="LeadOrbit AI <alerts@example.com>"

# --- Social autopilot (optional) ---
# Self-hosted Ollama for the AI writer (Gemini/Groq/OpenRouter keys are set in the app instead).
OLLAMA_URL=
# Facebook/Instagram Graph API version used for publishing.
META_GRAPH_VERSION=v23.0
