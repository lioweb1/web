# Required for real analysis. Without it the app still runs in demo mode.
ANTHROPIC_API_KEY=
# Optional overrides
MEDCHRONO_MODEL=claude-opus-5-5
MEDCHRONO_EFFORT=high
# Pages sent to the model per request (smaller = more accurate page citations, more requests)
MEDCHRONO_PAGES_PER_CHUNK=30

# PostgreSQL (accounts, sessions, credits). Tables are created automatically on first use.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medchrono
# Set to "true" for managed Postgres that requires TLS (e.g. AWS RDS)
DATABASE_SSL=false

# Public URL used for Stripe redirects (optional; derived from the request if unset)
APP_URL=http://localhost:3000

# Stripe (payments). Use test keys (sk_test_...) until you go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shown on the landing page "Contact sales" button
NEXT_PUBLIC_SALES_EMAIL=sales@example.com
